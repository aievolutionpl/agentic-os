  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-test-isolation=none tests/security.test.mjs tests/store.test.mjs tests/ui.test.mjs tests/lifecycle.test.mjs tests/lifecycle-ui.test.mjs tests/contrast.test.mjs tests/adapters.test.mjs tests/runtime.test.mjs tests/extensions.test.mjs tests/connectors.test.mjs tests/workspace.test.mjs tests/master.test.mjs tests/chats.test.mjs tests/orchestration-journal.test.mjs tests/capabilities.test.mjs tests/attention.test.mjs tests/backup.test.mjs tests/policy.test.mjs tests/router.test.mjs tests/usage-ledger.test.mjs tests/observations.test.mjs tests/limit-bridge.test.mjs tests/terminals.test.mjs tests/premium-workspace.test.mjs tests/orchestration-parallel.test.mjs tests/review-evidence.test.mjs",
    "start": "npm run build && npm run runtime:install && electron .",
    "runtime:install": "node node_modules/electron/install.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:headless": "xvfb-run -a node scripts/smoke.mjs",
    "pretest": "npm run build",
    "notices": "node scripts/notices.mjs",
    "qa:contrast": "node scripts/contrast-qa.mjs",
    "probe:adapters": "node scripts/probe-adapters.mjs",
    "package:win": "npm run build && npm run runtime:install && electron-builder --win nsis --x64 --publish never",
    "smoke:package": "node scripts/package-smoke.mjs",
    "qa:tools": "node scripts/tools-qa.mjs",
    "qa:workspace": "node scripts/workspace-qa.mjs",
    "qa:harness": "node scripts/harness-qa.mjs",
    "qa:workbench": "node scripts/workbench-qa.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "qa:premium": "node scripts/premium-qa.mjs"
  },
