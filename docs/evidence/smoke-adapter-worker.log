  id: string;
  action: "queue" | "retry" | "cancel" | "dependencies";
  dependencyIds?: string[];
}
export interface Memory {
  id: string;
  projectId: string;
  content: string;
  source: string;
  createdAt: string;
}
export interface Preferences {
  language: "pl" | "en";
  theme: "dark" | "light";
}
export interface Integration {
  id: string;
  name: string;
  status: "not_configured";
  probe?: ProviderProbe;
  quota: {
    state: "unknown";
    remaining: null;
    unit: null;
    source: null;
    observedAt: null;
    resetAt: null;
  };
}
export type ProbeState = "passed" | "failed" | "unavailable" | "timed_out";
export interface ProviderProbe {
  installation: "installed" | "not_found" | "unknown";
  version: string | null;
  auth: "unknown";
  provenance: "local-command";
  observedAt: string;
  commands: {
    version: ProbeState;
    help: ProbeState;
    authStatus: ProbeState;
  };
  capabilities: {
    version: boolean;
    help: boolean;
    authStatus: boolean;
    execution: false;
  };
}
export interface Snapshot {
  projects: Project[];
  preferences: Preferences;
  integrations: Integration[];
}
export interface ProjectData {
  tasks: Task[];
  memory: Memory[];
  events: TaskEvent[];
}
export interface API {
  snapshot(): Promise<Snapshot>;
  taskAction(input: TaskAction): Promise<void>;
  projectData(id: string): Promise<ProjectData>;
  createProject(
