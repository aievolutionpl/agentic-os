  attempt: number;
  owner: string | null;
  expiresAt: number | null;
  heartbeatAt: number | null;
  failure: FailureCode | null;
  dependencies: string[];
  blockedBy: string[];
  ready: boolean;
  createdAt: string;
}
export type FailureCode =
  "worker_error" | "validation_failed" | "lease_expired";
export interface TaskEvent {
